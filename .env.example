# Recipient email address where flight alerts will be sent
RECIPIENT_EMAIL=your-email@gmail.com

# Resend API Key (Sign up for free at resend.com - 3000 free emails/month)
RESEND_API_KEY=re_123456789_your_key_here

# Alternatively, standard SMTP / Nodemailer settings (if not using Resend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password

# Flight Alert Settings
DEFAULT_ORIGIN=DEL
DEFAULT_MAX_PRICE=10000
CRON_SECRET=my_secure_cron_secret_123
